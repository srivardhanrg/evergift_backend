# ===================
# RATE LIMITING
# ===================
RATE_LIMIT_PREVIEWS_PER_DAY=3
RATE_LIMIT_UPLOADS_PER_HOUR=10

# ===================
# GENERATION SETTINGS
# ===================
PREVIEW_PAGES=5
FULL_BOOK_PAGES=10
IMAGE_QUALITY=high
