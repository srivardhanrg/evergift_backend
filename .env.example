# ===================
# APP CONFIGURATION
# ===================
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=your-secret-key-min-32-chars-change-this-in-production

# ===================
# DATABASE (Supabase)
# ===================
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# ===================
# STORAGE (Cloudflare R2)
# ===================
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=magictales-storage
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
R2_ENDPOINT_URL=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com

# ===================
# AI SERVICES
# ===================
FAL_API_KEY=your-fal-ai-api-key
SEGMIND_API_KEY=your-segmind-api-key  # For cartoon face swap (FaceSwap Comic)

# ===================
# AI MODEL CONFIGURATION
# ===================
# Artistic Pipeline Models
ARTISTIC_BASE_MODEL=flux_dev
ARTISTIC_FACE_MODEL=fal_face_swap

# Photorealistic Pipeline Model
REALISTIC_MODEL=flux_pulid

# Fallback Models (used if primary fails)
FALLBACK_BASE_MODEL=flux_schnell
FALLBACK_REALISTIC_MODEL=instant_id

# Model Settings
DEFAULT_SEED=42
GUIDANCE_SCALE=7.5
NUM_INFERENCE_STEPS=30

# Feature Flags
ENABLE_MODEL_FALLBACK=true
ENABLE_MODEL_LOGGING=true

# Cartoon Pipeline Selection (DEPRECATED - always uses two-stage now)
# Cartoon3D pipeline has been deprecated in favor of CartoonTwoStagePipeline
# This setting is kept for backward compatibility but is no longer read
USE_TWOSTAGE_CARTOON_PIPELINE=true

# ===================
# SHOPIFY (required in production)
# ===================
# NOTE: App will FAIL to start in production if these are not set!
# 
# SHOPIFY_SHOP_DOMAIN: Your store's domain (e.g., your-store.myshopify.com)
# SHOPIFY_WEBHOOK_SECRET: Get from Shopify Admin > Settings > Notifications > Webhooks
# SHOPIFY_API_SECRET: Get from Shopify Partners > Your App > API credentials
#
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_WEBHOOK_SECRET=your-webhook-secret
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_PHYSICAL_VARIANT_ID=51975725482260    # Physical book variant (triggers Lulu print)

# ===================
# LULU PRINT-ON-DEMAND
# ===================
# Get credentials from Lulu Developer Portal: https://developers.lulu.com/
LULU_CLIENT_KEY=your-lulu-client-key
LULU_CLIENT_SECRET=your-lulu-client-secret
LULU_API_BASE=https://api.lulu.com                          # Production (use https://api.sandbox.lulu.com for testing)
LULU_AUTH_URL=https://api.lulu.com/auth/realms/glasstree/protocol/openid-connect/token
LULU_POD_PACKAGE_ID=0850X0850FCPRESS080CW444GXX             # 8.5x8.5" premium color saddle stitch

# ===================
# RATE LIMITING
# ===================
RATE_LIMIT_PREVIEWS_PER_DAY=3
RATE_LIMIT_UPLOADS_PER_HOUR=10

# ===================
# GENERATION SETTINGS
# ===================
PREVIEW_PAGES=5
FULL_BOOK_PAGES=10
IMAGE_QUALITY=high
